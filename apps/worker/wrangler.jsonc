{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bcd-embed-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "@bcd-embed/server": "../../packages/server/src/index.ts",
    "@bcd-embed/schema": "../../packages/schema/src/index.ts",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "bcd-embed-artifacts",
    },
  ],
}
