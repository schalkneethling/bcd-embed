{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bcd-embed-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  // Serve only on the custom domain. Turning workers.dev off does not turn off
  // preview or version URLs, so preview_urls is set explicitly (Document 9).
  "routes": [{ "pattern": "api.browser-compat.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "alias": {
    "@bcd-embed/server": "../../packages/server/src/index.ts",
    "@bcd-embed/schema": "../../packages/schema/src/index.ts",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "bcd-embed-artifacts",
    },
  ],
}
