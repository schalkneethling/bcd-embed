{
  "name": "@bcd-embed/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir ../../.wrangler/worker-dry-run",
    "test": "vitest run --config ../../vitest.config.ts tests",
    "typecheck": "wrangler types worker-configuration.d.ts --include-runtime=false --check && tsc --noEmit && tsc --noEmit --project tsconfig.test.json",
    "wrangler:types": "wrangler types worker-configuration.d.ts --include-runtime=false",
    "wrangler:dry-run": "wrangler deploy --dry-run --outdir ../../.wrangler/worker-dry-run"
  },
  "dependencies": {
    "@bcd-embed/server": "workspace:*"
  },
  "devDependencies": {
    "@bcd-embed/generator": "workspace:*",
    "@bcd-embed/schema": "workspace:*",
    "@cloudflare/workers-types": "5.20260929.1",
    "@mdn/browser-compat-data": "8.1.3",
    "miniflare": "5.20260923.0-alpha",
    "wrangler": "4.140.0"
  }
}
