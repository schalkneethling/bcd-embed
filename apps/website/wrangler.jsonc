{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The documentation site is static files only. There is no Worker script:
  // Cloudflare serves the contents of `dist/`, which `astro build` writes.
  "name": "bcd-embed-website",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    // Serve Starlight's `404.html` for a path that matches no file.
    "not_found_handling": "404-page",
  },
}
