{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The introduction page is static files only. There is no Worker script:
  // Cloudflare serves the contents of `dist/`, which `astro build` writes.
  "name": "bcd-embed-home",
  "compatibility_date": "2026-09-23",
  // Serve only on the apex custom domain. Turning workers.dev off does not turn off
  // preview or version URLs, so preview_urls is set explicitly (Document 9).
  "routes": [{ "pattern": "browser-compat.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
  },
}
