---
import bcd from "@mdn/browser-compat-data";

import "../styles/fonts.css";
import "@schalkneethling/bcd-embed/base.css";
import "../styles/home.css";
import elementManifest from "../../../../packages/element/package.json";
import { buildHomePageData } from "../data/examples.js";
import { describeRelease } from "../data/release.js";

// Runs once, at build time. It throws when BCD lacks any of the keys, which fails the build.
const { bcdVersion, examples, live } = buildHomePageData(bcd);
// The badge and the install command follow the element's version, so neither goes stale.
const release = describeRelease(elementManifest);
const repository = "https://github.com/schalkneethling/bcd-embed";
const documentation = "https://docs.browser-compat.dev/";

// What a link preview shows. `og:url` and `og:image` must be absolute, so both are resolved against
// the `site` in astro.config.ts. The width and height match the file in `public/`, which
// `tests/home-deploy.test.ts` checks.
const title = "bcd-embed: browser compatibility tables for any page";
const description =
  "Embeddable browser compatibility tables backed by MDN Browser Compatibility Data.";
const pageUrl = new URL("/", Astro.site).href;
const preview = {
  url: new URL("/og-image.png", Astro.site).href,
  width: 1280,
  height: 640,
  alt: "A wooden workbench with a green cutting mat holding a hammer, nails, a screwdriver, wooden planks and small coloured blocks, beside the bcd-embed wordmark and the tagline “add MDN-powered browser compatibility tables anywhere”.",
};

// Shown to readers as text. Astro escapes it, so its `<` characters reach the page as `&lt;`.
const sourceModeSnippet = `<script type="application/json" id="bcd-data-css-properties-line-clamp">
  { "contract": "1.1.0", "query": "css.properties.line-clamp", … }
</script>
<bcd-compat-table source="bcd-data-css-properties-line-clamp">
  <p><a href="…">Browser compatibility for line-clamp on MDN Web Docs</a></p>
</bcd-compat-table>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="bcd-embed" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={preview.url} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(preview.width)} />
    <meta property="og:image:height" content={String(preview.height)} />
    <meta property="og:image:alt" content={preview.alt} />
    <!-- X reads the title, description, image and alt text from the Open Graph tags above. -->
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
      <nav class="site-header__nav" aria-label="Main">
        <ul class="site-header__links">
          <li><a href="#examples">Examples</a></li>
          <li><a href={documentation}>Documentation</a></li>
          <li><a href={`${documentation}#the-endpoints`}>API</a></li>
          <li><a href={repository}>GitHub</a></li>
        </ul>
      </nav>
    </header>
    <main id="main">
      <div class="hero">
        <p class="hero__release">{release.badge}</p>
        <h1 class="hero__title">bcd-embed</h1>
        <p class="hero__tagline">add MDN-powered browser compatibility tables anywhere</p>
        <p class="hero__lede">
          bcd-embed puts a browser compatibility table on any page. A small API serves MDN's Browser
          Compatibility Data (BCD), and the <code>&lt;bcd-compat-table&gt;</code> web component turns
          it into an accessible table that you style with your own CSS.
        </p>
        <div class="hero__actions">
          <a class="hero__start" href={`${documentation}component/getting-started/`}>Get started</a>
          <p class="hero__install"><code>{release.installCommand}</code></p>
        </div>
      </div>

      <section class="examples" id="examples" aria-labelledby="examples-heading">
        <h2 id="examples-heading">Try an example</h2>
        <p>
          The four tables below were built into this page from BCD {bcdVersion}, so showing them sends
          no request.
        </p>
        <fieldset class="example-choices">
          <legend>Choose an example</legend>
          {
            examples.map((example, index) => (
              <>
                <input
                  type="radio"
                  name="example"
                  id={`example-${example.id}`}
                  value={example.id}
                  data-announcement={example.announcement}
                  checked={index === 0}
                />
                <label for={`example-${example.id}`}>{example.label}</label>
              </>
            ))
          }
        </fieldset>

        <div class="example-panels">
          {
            examples.map((example) => (
              <section
                class="example-panel"
                id={`panel-${example.id}`}
                data-example={example.id}
              >
                <h3>
                  {example.label}: <code>{example.name}</code>
                </h3>
                <p>{example.summary}</p>
                <script
                  is:inline
                  type="application/json"
                  id={example.scriptId}
                  set:html={example.scriptJson}
                />
                <bcd-compat-table source={example.scriptId}>
                  <p>
                    <a href={example.mdnPage.url}>
                      Browser compatibility for <code>{example.mdnPage.name}</code> on MDN Web Docs
                    </a>
                  </p>
                </bcd-compat-table>
              </section>
            ))
          }
        </div>
      </section>

      <section class="how" aria-labelledby="how-heading">
        <h2 id="how-heading">How the examples work</h2>
        <p>
          Each example is two pieces of HTML that the build writes into the page: a JSON script
          that holds the API's answer for the feature, and the element that names it with its{" "}
          <code>source</code> attribute. The element reads the script once, renders the table, and
          sends no request.
        </p>
        <pre class="how__snippet"><code>{sourceModeSnippet}</code></pre>
        <p>
          The link inside the element is its fallback content. It shows until the table renders, and
          it stays when script is turned off, so every reader can reach the data on MDN Web Docs.
          The examples switch with CSS alone, so choosing one works without script too.
        </p>
      </section>

      <section class="live" aria-labelledby="live-heading">
        <h2 id="live-heading">A table fetched from the API</h2>
        <p>
          This table asks the hosted API for <code>{live.key}</code> when you scroll near it, and
          not before. It always shows the API's current data.
        </p>
        <bcd-compat-table query={live.key}>
          <p>
            <a href={live.mdnPage.url}>
              Browser compatibility for <code>{live.mdnPage.name}</code> on MDN Web Docs
            </a>
          </p>
        </bcd-compat-table>
      </section>
    </main>
    <footer class="site-footer">
      <p>
        The data comes from{" "}
        <a href="https://github.com/mdn/browser-compat-data">MDN Browser Compatibility Data</a>.
        Read the <a href={documentation}>documentation</a> or the{" "}
        <a href={repository}>source code</a>. The typefaces are used under the{" "}
        <a href="/font-licenses.txt">SIL Open Font License</a>.
      </p>
    </footer>
    <script>
      import "@schalkneethling/bcd-embed";
    </script>
    <script>
      // Its own script, so the status region does not depend on the element's bundle evaluating.
      import "../scripts/example-status.js";
    </script>
  </body>
</html>
