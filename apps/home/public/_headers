# Cloudflare reads this file from the assets directory and applies it to static
# asset responses. It is not served itself. A request that matches several
# rules receives the headers of all of them, and Cloudflare joins repeated
# header names with a comma, so each header name appears under one rule only.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Enforcing. The page is one HTML file, one stylesheet and two scripts, with
  # no inline script, no inline style, no font and no frame, so each directive
  # below is `'none'` or `'self'` except `connect-src`, which names the hosted
  # API that the live table asks for its data. `img-src 'self'` is there for
  # Firefox, which checks its request for /favicon.ico against it. The reason
  # for each directive is in apps/website/src/content/docs/deployment.md.
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src https://api.browser-compat.dev; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Astro writes a content hash into the name of every file in `_astro/`, so a
# file at one address never changes.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
