{
  "name": "@bcd-embed/schema",
  "version": "0.0.0",
  "description": "Canonical schemas and TypeScript types for the bcd-embed API contract.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures/v1": {
      "types": "./dist/fixtures/v1.d.ts",
      "import": "./dist/fixtures/v1.js"
    },
    "./json-schema/feature-response": "./dist/json-schema/feature-response.schema.json",
    "./json-schema/browsers-response": "./dist/json-schema/browsers-response.schema.json",
    "./json-schema/index-response": "./dist/json-schema/index-response.schema.json",
    "./json-schema/meta-response": "./dist/json-schema/meta-response.schema.json",
    "./json-schema/api-error-response": "./dist/json-schema/api-error-response.schema.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build --mode lib && tsc --project tsconfig.build.json && node scripts/copy-json-schemas.mjs && node scripts/package-smoke-test.mjs",
    "generate:fixtures": "node scripts/generate-source-fixtures.mjs",
    "generate:json-schema": "node scripts/generate-json-schemas.mjs",
    "test": "node scripts/generate-source-fixtures.mjs --check && node scripts/generate-json-schemas.mjs --check && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mdn/browser-compat-data": "8.0.13",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
