{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcd-embed.dev/schemas/v1/index-response.schema.json",
  "title": "Feature index response",
  "$comment": "Relational invariants documented by the v1 contract are additionally enforced by the canonical Zod schemas.",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "1.0.0"
    },
    "namespace": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "keys": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._$@-]*$"
      }
    }
  },
  "required": [
    "contract",
    "namespace",
    "keys"
  ],
  "additionalProperties": false
}
