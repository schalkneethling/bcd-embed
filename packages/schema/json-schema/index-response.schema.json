{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcd-embed.dev/schemas/v1/index-response.schema.json",
  "title": "Feature index response",
  "$comment": "Relational invariants documented by the v1 contract are additionally enforced by the canonical Zod schemas.",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "1.0.0"
    },
    "generated": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "source": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string",
          "const": "@mdn/browser-compat-data"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "package",
        "version"
      ],
      "additionalProperties": false
    },
    "namespace": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "keys": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._$@-]*$"
      }
    }
  },
  "required": [
    "contract",
    "generated",
    "source",
    "namespace",
    "keys"
  ],
  "additionalProperties": false
}
