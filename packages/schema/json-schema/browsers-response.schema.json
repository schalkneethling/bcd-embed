{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcd-embed.dev/schemas/v1/browsers-response.schema.json",
  "title": "Browser metadata response",
  "$comment": "Relational invariants documented by the v1 contract are additionally enforced by the canonical Zod schemas.",
  "type": "object",
  "properties": {
    "contract": {
      "type": "string",
      "const": "1.0.0"
    },
    "generated": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "source": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string",
          "const": "@mdn/browser-compat-data"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "package",
        "version"
      ],
      "additionalProperties": false
    },
    "browsers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "desktop",
              "mobile",
              "xr",
              "server"
            ]
          },
          "previewName": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "releases": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "releaseDate": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "retired",
                    "current",
                    "beta",
                    "nightly",
                    "esr",
                    "planned"
                  ]
                }
              },
              "required": [
                "version",
                "releaseDate",
                "status"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "type",
          "previewName",
          "releases"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract",
    "generated",
    "source",
    "browsers"
  ],
  "additionalProperties": false
}
