{
  "name": "@bcd-embed/element",
  "version": "0.0.0",
  "private": true,
  "description": "The bcd-compat-table web component and its message table.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./base.css": "./dist/base.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build --mode lib && tsc --project tsconfig.build.json && size-limit",
    "build:screen-reader-fixture": "vite build --mode lib && vite build --config vite.screen-reader.config.ts",
    "cem": "cem analyze",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:nvda": "playwright test --config playwright.nvda.config.ts",
    "test:orca": "playwright test --config playwright.orca.config.ts",
    "test:voiceover": "playwright test --config playwright.voiceover.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lit/task": "1.0.3",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@bcd-embed/schema": "workspace:*",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@guidepup/guidepup": "0.39.0",
    "@guidepup/playwright": "0.21.0",
    "@mdn/browser-compat-data": "8.1.9",
    "@playwright/test": "1.65.1",
    "@size-limit/preset-small-lib": "14.3.0",
    "postcss": "8.5.32",
    "size-limit": "14.3.0"
  }
}
