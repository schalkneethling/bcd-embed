{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@bcd-embed/schema": ["../schema/src/index.ts"],
      "@bcd-embed/element": ["./src/index.ts"]
    }
  },
  "include": [
    "*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "screen-reader/**/*.ts",
    "browser/**/*.ts",
    "e2e/**/*.ts",
    "e2e/**/*.tsx"
  ]
}
