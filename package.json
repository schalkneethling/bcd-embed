{
  "name": "bcd-embed",
  "version": "0.0.0",
  "private": true,
  "description": "Embeddable browser compatibility tables backed by MDN Browser Compatibility Data.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "dev": "pnpm --filter @bcd-embed/docs dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . && stylelint \"**/*.{css,scss}\"",
    "test": "vitest run",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "lint:fix": "oxlint --fix . && stylelint \"**/*.{css,scss}\" --fix",
    "quality": "pnpm lint && pnpm format:check && pnpm typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-plugin-use-baseline": "^1.4.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.13.0"
}
